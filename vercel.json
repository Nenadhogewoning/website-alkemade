{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/index\\.html",
      "methods": [
        "GET",
        "HEAD"
      ],
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/404\\.html",
      "status": 404,
      "dest": "/404.html",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api(?:/.*)?",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html",
      "headers": {
        "Cache-Control": "no-store"
      }
    }
  ]
}
